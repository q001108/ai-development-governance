{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/q001108/ai-development-governance/governance/v3/control-profile.schema.json",
  "title": "ControlProfile v3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "GovernanceVersion", "DecisionRulesVersion", "RequirementId", "ProfileVersion", "SelectedProfile", "MinimumProfile", "PreviousProfileRef", "PreviousProfileRevision", "Classification", "BusinessAcceptanceSources", "ExecutionBudget", "PlatformScope", "RecordRefs"],
  "properties": {
    "SchemaVersion": {"enum": ["v3.0", "v3.0.1"]},
    "GovernanceVersion": {"enum": ["v3.0", "v3.0.1"]},
    "DecisionRulesVersion": {"enum": ["v3.0", "v3.0.1"]},
    "RequirementId": {"type": "string", "pattern": "^REQ-(?:[0-9]{8}-[0-9]{3}|[A-Z0-9](?:[A-Z0-9._-]{0,30}[A-Z0-9])?-[0-9]{8}-[0-9]{2,})$"},
    "ProfileVersion": {"type": "string", "pattern": "^v[1-9][0-9]*\\.[0-9]+$"},
    "SelectedProfile": {"enum": ["LEAN", "STANDARD", "CONTROLLED"]},
    "MinimumProfile": {"enum": ["LEAN", "STANDARD", "CONTROLLED"]},
    "PreviousProfileRef": {"type": ["string", "null"], "minLength": 1},
    "PreviousProfileRevision": {"type": ["string", "null"], "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
    "Classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["HardTriggers", "UpgradeTriggers", "LeanQualifications", "Unknowns", "DecisionRefs"],
      "properties": {
        "HardTriggers": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/hardTrigger"}},
        "UpgradeTriggers": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/upgradeTrigger"}},
        "LeanQualifications": {"type": "array", "items": {"$ref": "#/$defs/qualification"}, "minItems": 7, "maxItems": 7},
        "Unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
        "DecisionRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "BusinessAcceptanceSources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/businessSource"}},
    "ExecutionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PlanningMinutes", "ImplementationMinutes", "ImplementationAndControlsMinutes", "BlockingControlCount", "AtomicRiskTargetCount", "BlockingControlsMinutes", "AdvisoryMinutes", "WorkPackageCount"],
      "properties": {
        "PlanningMinutes": {"type": "integer", "minimum": 0},
        "ImplementationMinutes": {"type": "integer", "minimum": 0},
        "ImplementationAndControlsMinutes": {"type": "integer", "minimum": 0},
        "BlockingControlCount": {"type": "integer", "minimum": 0},
        "AtomicRiskTargetCount": {"type": "integer", "minimum": 0},
        "BlockingControlsMinutes": {"type": "integer", "minimum": 0},
        "AdvisoryMinutes": {"type": "integer", "minimum": 0},
        "WorkPackageCount": {"type": "integer", "minimum": 1}
      }
    },
    "PlatformScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["LocalDevelopment", "DeliveryValidation", "DeliveryValidationStatus", "CodexDesktopMultiAgent"],
      "properties": {
        "LocalDevelopment": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["WINDOWS", "MACOS", "LINUX"]}},
        "DeliveryValidation": {"enum": ["NOT_APPLICABLE", "PROJECT_DEFINED", "WINDOWS", "MACOS", "LINUX", "LINUX_PRODUCTION", "CROSS_PLATFORM"]},
        "DeliveryValidationStatus": {"enum": ["AVAILABLE", "NOT_AVAILABLE", "NOT_APPLICABLE"]},
        "CodexDesktopMultiAgent": {"type": "boolean"}
      }
    },
    "BaselineBindings": {"type": "object", "additionalProperties": false, "required": ["Governance", "BusinessRevision", "Testing"], "properties": {"Governance": {"type": "object", "additionalProperties": false, "required": ["Version", "SourceRef", "SourceDigest", "Revision"], "properties": {"Version": {"const": "v3.0.1"}, "SourceRef": {"type": "string", "minLength": 1}, "SourceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "Revision": {"type": ["string", "null"], "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"}}}, "BusinessRevision": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"}, "Testing": {"$ref": "#/properties/BaselineBindings/properties/Governance"}}},
    "RecordRefs": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"GovernanceVersion": {"const": "v3.0.1"}}, "required": ["GovernanceVersion"]}, "then": {"required": ["BaselineBindings"]}},
    {
      "if": {"properties": {"ProfileVersion": {"const": "v1.0"}}, "required": ["ProfileVersion"]},
      "then": {"properties": {"PreviousProfileRef": {"type": "null"}, "PreviousProfileRevision": {"type": "null"}}},
      "else": {"properties": {"PreviousProfileRef": {"type": "string", "minLength": 1}, "PreviousProfileRevision": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"}}}
    }
  ],
  "$defs": {
    "hardTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Code", "Matched", "EvidenceRefs"],
      "properties": {
        "Code": {"enum": ["SECURITY_AUTH_PRIVACY", "REGULATED_LEGAL_FINANCIAL", "DESTRUCTIVE_OR_IRREVERSIBLE", "PRODUCTION_RELEASE", "BREAKING_SHARED_CONTRACT", "PROTECTED_DATA_MIGRATION", "USER_MANDATED_CONTROLLED"]},
        "Matched": {"type": "boolean"},
        "EvidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "upgradeTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Code", "Matched", "EvidenceRefs"],
      "properties": {
        "Code": {"enum": ["MULTIPLE_WORK_PACKAGES", "SHARED_CONTRACT_NON_BREAKING", "CROSS_MODULE_OR_TEAM", "EXTERNAL_INTEGRATION", "INDEPENDENT_QUALITY_JUDGMENT", "LEAN_BUDGET_EXCEEDED", "LEAN_QUALIFICATION_FAILED", "UNKNOWN_NON_PROTECTED_FACT", "USER_MANDATED_STANDARD"]},
        "Matched": {"type": "boolean"},
        "EvidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Code", "Satisfied", "EvidenceRefs"],
      "properties": {
        "Code": {"enum": ["SINGLE_WORK_PACKAGE", "LOCAL_REVERSIBLE_CHANGE", "NO_SHARED_OR_PROTECTED_SURFACE", "NO_EXTERNAL_DB_CI_OR_PRODUCTION", "LOCAL_DETERMINISTIC_BLOCKING_GATES", "AT_MOST_EIGHT_BLOCKING_CONTROLS", "WITHIN_LEAN_TIME_BUDGET"]},
        "Satisfied": {"type": "boolean"},
        "EvidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Code", "CouldBeControlled", "EvidenceRefs"],
      "properties": {
        "Code": {"type": "string", "minLength": 1},
        "CouldBeControlled": {"type": "boolean"},
        "EvidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "businessSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AcceptanceSourceId", "SourceKind", "SourceRef", "AcceptanceText", "ApprovalRef", "SourceArtifactVersion", "SourceDigest", "ApprovalDigest", "ProvenanceRevision"],
      "properties": {
        "AcceptanceSourceId": {"type": "string", "pattern": "^BAS-[0-9]{3}$"},
        "SourceKind": {"enum": ["USER_REQUIREMENT", "FORMAL_BUSINESS_CONTRACT"]},
        "SourceRef": {"type": "string", "minLength": 1},
        "AcceptanceText": {"type": "string", "minLength": 1},
        "ApprovalRef": {"type": "string", "minLength": 1},
        "SourceArtifactVersion": {"type": "string", "pattern": "^v[1-9][0-9]*\\.[0-9]+$"},
        "SourceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "ApprovalDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "ProvenanceRevision": {"type": ["string", "null"], "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"}
      }
    }
  }
}
