{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/q001108/ai-development-governance/governance/v3/replay-expectations.schema.json",
  "title": "Replay Expectations v3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "RequirementId", "RequiredRuleRefs", "ExpectedControlCounts", "ExpectedBlockingControlsMinutes", "ExpectedAdvisoryMinutes", "ReportRequiredTokens"],
  "properties": {
    "SchemaVersion": {"const": "v3.0"},
    "RequirementId": {"type": "string", "pattern": "^REQ-(?:[0-9]{8}-[0-9]{3}|[A-Z0-9](?:[A-Z0-9._-]{0,30}[A-Z0-9])?-[0-9]{8}-[0-9]{2,})$"},
    "RequiredRuleRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RULE:[A-Z]{2,8}-[0-9]{3}$"}},
    "ExpectedControlCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["BA", "RB", "QG", "AD"],
      "properties": {
        "BA": {"type": "integer", "minimum": 0},
        "RB": {"type": "integer", "minimum": 0},
        "QG": {"type": "integer", "minimum": 0},
        "AD": {"type": "integer", "minimum": 0}
      }
    },
    "ExpectedBlockingControlsMinutes": {"type": "integer", "minimum": 0},
    "ExpectedAdvisoryMinutes": {"type": "integer", "minimum": 0},
    "ReportRequiredTokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
